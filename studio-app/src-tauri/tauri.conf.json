{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VESPER Studio",
  "version": "0.1.0",
  "identifier": "io.github.huuhuannt1998.vesperstudio",
  "build": { "frontendDist": "../start" },
  "app": {
    "windows": [
      { "label": "main", "title": "VESPER Studio", "width": 1280, "height": 820, "minWidth": 900, "minHeight": 600,
        "url": "index.html" }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "msi"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "category": "DeveloperTool",
    "shortDescription": "A smart-home simulation lab on a laptop",
    "macOS": { "minimumSystemVersion": "12.0" }
  }
}
